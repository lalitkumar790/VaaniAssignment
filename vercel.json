{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "results.csv",
      "use": "@vercel/static"
    },
    {
      "src": "REPORT.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "data/verified_notes.json",
      "use": "@vercel/static"
    },
    {
      "src": "artifacts/quality_results.csv",
      "use": "@vercel/static"
    },
    {
      "src": "artifacts/v3_fullpdf_quality_results.csv",
      "use": "@vercel/static"
    },
    {
      "src": "artifacts/v4_fullpdf_quality_results.csv",
      "use": "@vercel/static"
    },
    {
      "src": "api/ask.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "^/api/ask/?$",
      "dest": "/api/ask.py"
    },
    {
      "handle": "filesystem"
    }
  ]
}
